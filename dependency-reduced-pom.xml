<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.github.xima_formcycle_entwicklerkreis.fc.plugin</groupId>
  <artifactId>fc-plugin-codbi</artifactId>
  <name>fc-plugin-codbi</name>
  <version>1.0.0</version>
  <description>formcycle plugin developed as a joint cooperation of the Bavarian formcycle developer community. Adds
        additional features to forms and the form designer.</description>
  <url>https://github.com/XIMA-formcycle-Entwicklerkreis/CodBi</url>
  <issueManagement>
    <system>github</system>
    <url>https://github.com/XIMA-formcycle-Entwicklerkreis/CodBi/issues</url>
  </issueManagement>
  <contributors>
    <contributor>
      <name>Andre Wachsmuth</name>
      <email>awa@xima.de</email>
      <url>https://github.com/blutorange</url>
      <organization>xima media GmbH</organization>
      <organizationUrl>https://www.xima.de/</organizationUrl>
    </contributor>
  </contributors>
  <licenses>
    <license>
      <name>MIT</name>
      <url>https://opensource.org/license/mit</url>
    </license>
  </licenses>
  <scm>
    <connection>scm:git:https://github.com/XIMA-formcycle-Entwicklerkreis/CodBi.git</connection>
    <developerConnection>scm:git:https://github.com/XIMA-formcycle-Entwicklerkreis/CodBi.git</developerConnection>
    <url>https://github.com/XIMA-formcycle-Entwicklerkreis/CodBi</url>
  </scm>
  <build>
    <sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
    <testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
    <resources>
      <resource>
        <directory>${project.basedir}/src/main/resources</directory>
      </resource>
      <resource>
        <directory>${project.build.directory}/generated-resources</directory>
      </resource>
    </resources>
    <finalName>${project.artifactId}-${project.version}</finalName>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>${build-helper-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>de.xima.fc.maven.plugin</groupId>
          <artifactId>fc-build-helper-maven-plugin</artifactId>
          <version>${fc-build-helper-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>de.xima.fc.maven.plugin</groupId>
          <artifactId>fc-deploy-plugin-maven-plugin</artifactId>
          <version>${fc-deploy-plugin-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>de.xima.fc.maven.plugin</groupId>
          <artifactId>fc-server-maven-plugin</artifactId>
          <version>${fc-server-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>com.github.eirslett</groupId>
          <artifactId>frontend-maven-plugin</artifactId>
          <version>${frontend-maven-plugin.version}</version>
          <executions>
            <execution>
              <id>test</id>
              <phase>test</phase>
              <goals>
                <goal>yarn</goal>
              </goals>
              <configuration>
                <arguments>test</arguments>
                <skip>true</skip>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>com.rudikershaw.gitbuildhook</groupId>
          <artifactId>git-build-hook-maven-plugin</artifactId>
          <version>${git-build-hook-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.jetbrains.kotlin</groupId>
          <artifactId>kotlin-maven-plugin</artifactId>
          <version>${kotlin.version}</version>
          <configuration>
            <apiVersion>1.9</apiVersion>
            <languageVersion>1.9</languageVersion>
            <jvmTarget>${java.version}</jvmTarget>
          </configuration>
        </plugin>
        <plugin>
          <artifactId>maven-assembly-plugin</artifactId>
          <version>${maven-assembly-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${maven-clean-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${maven-deploy-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven-install-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-site-plugin</artifactId>
          <version>${maven-site-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>properties-maven-plugin</artifactId>
          <version>${properties-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <artifactId>maven-clean-plugin</artifactId>
        <executions>
          <execution>
            <id>selective-clean-before-compile</id>
            <phase>initialize</phase>
            <goals>
              <goal>clean</goal>
            </goals>
            <configuration>
              <excludeDefaultDirectories>true</excludeDefaultDirectories>
              <filesets>
                <fileset>
                  <directory>${project.build.outputDirectory}</directory>
                  <includes>
                    <include>**/*.class</include>
                  </includes>
                </fileset>
                <fileset>
                  <directory>${project.build.testOutputDirectory}</directory>
                  <includes>
                    <include>**/*.class</include>
                  </includes>
                </fileset>
                <fileset>
                  <directory>${web.output.directory}</directory>
                  <includes>
                    <include>**/*.js</include>
                    <include>**/*.js.map</include>
                  </includes>
                </fileset>
                <fileset>
                  <directory>${project.build.outputDirectory}</directory>
                  <includes>
                    <include>**/*.js</include>
                    <include>**/*.js.map</include>
                  </includes>
                </fileset>
                <fileset>
                  <directory>${project.build.directory}</directory>
                  <includes>
                    <include>*.jar</include>
                  </includes>
                </fileset>
              </filesets>
            </configuration>
          </execution>
          <execution>
            <id>selective-clean-after-build</id>
            <phase>package</phase>
            <goals>
              <goal>clean</goal>
            </goals>
            <configuration>
              <excludeDefaultDirectories>true</excludeDefaultDirectories>
              <filesets>
                <fileset>
                  <directory>${project.build.outputDirectory}</directory>
                  <includes>
                    <include>**/*.class</include>
                  </includes>
                </fileset>
                <fileset>
                  <directory>${project.build.testOutputDirectory}</directory>
                  <includes>
                    <include>**/*.class</include>
                  </includes>
                </fileset>
              </filesets>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <excludeDefaultDirectories>false</excludeDefaultDirectories>
          <filesets>
            <fileset>
              <directory>${web.directory}/dist</directory>
            </fileset>
            <fileset>
              <directory>${web.directory}/packages/common/dist</directory>
            </fileset>
            <fileset>
              <directory>${web.directory}/packages/form/dist</directory>
            </fileset>
            <fileset>
              <directory>${web.directory}/packages/designer/dist</directory>
            </fileset>
            <fileset>
              <directory>${web.yarn.directory}/unplugged</directory>
              <followSymlinks>false</followSymlinks>
            </fileset>
            <fileset>
              <directory>${web.yarn.directory}</directory>
              <includes>
                <include>build-state.yml</include>
                <include>install-state.gz</include>
              </includes>
            </fileset>
            <fileset>
              <directory>${web.directory}</directory>
              <includes>
                <include>**.tgz</include>
                <include>.pnp.*</include>
                <include>**/localization.ts</include>
                <include>**/constants.ts</include>
              </includes>
            </fileset>
          </filesets>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>properties-maven-plugin</artifactId>
        <executions>
          <execution>
            <phase>initialize</phase>
            <goals>
              <goal>read-project-properties</goal>
            </goals>
            <configuration>
              <files>
                <file>src/main/resources/com/github/xima_formcycle_entwicklerkreis/fc/plugin/codbi/constants.properties</file>
              </files>
              <keyPrefix>constants.</keyPrefix>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.rudikershaw.gitbuildhook</groupId>
        <artifactId>git-build-hook-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>install</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <installHooks>
            <pre-commit>hooks/pre-commit</pre-commit>
          </installHooks>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-source</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${project.build.directory}/generated-sources</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <configuration>
          <kotlin>
            <ktfmt>
              <version>${ktfmt.version}</version>
              <style>META</style>
              <maxWidth>100</maxWidth>
              <blockIndent>2</blockIndent>
              <continuationIndent>4</continuationIndent>
              <removeUnusedImports>true</removeUnusedImports>
              <manageTrailingCommas>false</manageTrailingCommas>
            </ktfmt>
          </kotlin>
          <pom>
            <includes>
              <include>pom.xml</include>
            </includes>
            <sortPom>
              <lineSeparator>\n</lineSeparator>
              <nrOfIndentSpace>-1</nrOfIndentSpace>
              <keepBlankLines>true</keepBlankLines>
              <expandEmptyElements>false</expandEmptyElements>
            </sortPom>
          </pom>
          <formats>
            <format>
              <includes>
                <include>src/**/*.ts</include>
                <include>src/**/*.js</include>
                <include>src/**/*.json</include>
              </includes>
              <excludes>
                <exclude>**/package.json</exclude>
                <exclude>**/.yarn/**</exclude>
                <exclude>**/node_modules/**</exclude>
                <exclude>**/.pnp*</exclude>
                <exclude>**/target/**</exclude>
                <exclude>**/dist/**</exclude>
                <exclude>**/localization.ts</exclude>
              </excludes>
              <biome>
                <version>${biome.version}</version>
                <configPath>${web.directory}</configPath>
              </biome>
            </format>
          </formats>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>default-cli</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[11,]</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>${maven.version}</version>
                </requireMavenVersion>
                <dependencyConvergence />
                <reactorModuleConvergence />
                <banDuplicatePomDependencyVersions />
                <requirePluginVersions />
                <requireUpperBoundDeps />
                <banProvidedDependencies>
                  <provisions>
                    <provision>
                      <groupId>de.xima.fc</groupId>
                      <artifactId>fc-plugin-common</artifactId>
                    </provision>
                  </provisions>
                </banProvidedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
        <dependencies>
          <dependency>
            <groupId>de.xima.fc.maven.enforcer</groupId>
            <artifactId>maven-enforcer-rule-ban-provided-dependencies</artifactId>
            <version>${maven-enforcer-rule-ban-provided-dependencies.version}</version>
          </dependency>
        </dependencies>
      </plugin>
      <plugin>
        <groupId>de.xima.fc.maven.plugin</groupId>
        <artifactId>fc-build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>clean-yarn-snapshots</id>
            <phase>initialize</phase>
            <goals>
              <goal>delete-outdated-snapshots-from-yarn-cache</goal>
            </goals>
            <configuration>
              <yarnProjectRoot>${web.directory}</yarnProjectRoot>
            </configuration>
          </execution>
          <execution>
            <id>set-package-json-versions</id>
            <phase>initialize</phase>
            <goals>
              <goal>update-package-json-versions</goal>
            </goals>
            <configuration>
              <inputs>
                <input>${web.directory}/package.json</input>
              </inputs>
              <recurse>true</recurse>
              <updates>
                <update>
                  <packageName>codbi</packageName>
                  <version>${project.version}</version>
                  <updateInPackage>true</updateInPackage>
                  <updateInDependency>false</updateInDependency>
                </update>
                <update>
                  <packageName>codbi-common</packageName>
                  <version>${project.version}</version>
                  <updateInPackage>true</updateInPackage>
                  <updateInDependency>false</updateInDependency>
                </update>
                <update>
                  <packageName>codbi-designer</packageName>
                  <version>${project.version}</version>
                  <updateInPackage>true</updateInPackage>
                  <updateInDependency>false</updateInDependency>
                </update>
                <update>
                  <packageName>codbi-form</packageName>
                  <version>${project.version}</version>
                  <updateInPackage>true</updateInPackage>
                  <updateInDependency>false</updateInDependency>
                </update>
                <update>
                  <packageName>@de-xima/fc-backend-common</packageName>
                  <version>${xfc.version}</version>
                </update>
                <update>
                  <packageName>@de-xima/fc-form-renderer</packageName>
                  <version>${xfc.version}</version>
                </update>
                <update>
                  <packageName>@de-xima/fc-form-designer</packageName>
                  <version>${xfc.version}</version>
                </update>
              </updates>
            </configuration>
          </execution>
          <execution>
            <id>generate-constants-kotlin</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>create-i18n-entries</goal>
            </goals>
            <configuration>
              <autoGeneratedComment>default</autoGeneratedComment>
              <emptyValue>&lt;empty&gt;</emptyValue>
              <kind>KOTLIN_CONST</kind>
              <name>Constants</name>
              <javaPackage>com.github.xima_formcycle_entwicklerkreis.fc.plugin.codbi.model</javaPackage>
              <input>src/main/resources/com/github/xima_formcycle_entwicklerkreis/fc/plugin/codbi/constants.properties</input>
              <inputEncoding>UTF-8</inputEncoding>
              <output>${project.build.directory}/generated-sources/com/github/xima_formcycle_entwicklerkreis/fc/plugin/codbi/model/Constants.kt</output>
            </configuration>
          </execution>
          <execution>
            <id>generate-codbi-config-template-kotlin</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>create-i18n-key-declarations</goal>
            </goals>
            <configuration>
              <autoGeneratedComment>default</autoGeneratedComment>
              <kind>KOTLIN_ENUM</kind>
              <name>CodbiConfigTemplate</name>
              <javaPackage>com.github.xima_formcycle_entwicklerkreis.fc.plugin.codbi.model</javaPackage>
              <input>src/main/resources/com/github/xima_formcycle_entwicklerkreis/fc/plugin/codbi/codbi-config-template.properties</input>
              <inputEncoding>UTF-8</inputEncoding>
              <output>${project.build.directory}/generated-sources/com/github/xima_formcycle_entwicklerkreis/fc/plugin/codbi/model/CodbiConfigTemplate.kt</output>
            </configuration>
          </execution>
          <execution>
            <id>generate-i18n-keys-kotlin</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>create-i18n-key-declarations</goal>
            </goals>
            <configuration>
              <autoGeneratedComment>default</autoGeneratedComment>
              <kind>KOTLIN_ENUM</kind>
              <name>EMessageKey</name>
              <javaPackage>com.github.xima_formcycle_entwicklerkreis.fc.plugin.codbi.model</javaPackage>
              <input>src/main/resources/com/github/xima_formcycle_entwicklerkreis/fc/plugin/codbi/i18n*.properties</input>
              <inputEncoding>UTF-8</inputEncoding>
              <output>${project.build.directory}/generated-sources/com/github/xima_formcycle_entwicklerkreis/fc/plugin/codbi/model/EMessageKey.kt</output>
            </configuration>
          </execution>
          <execution>
            <id>generate-constants-typescript</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>create-i18n-entries</goal>
            </goals>
            <configuration>
              <autoGeneratedComment>default</autoGeneratedComment>
              <kind>TYPESCRIPT_CONST</kind>
              <name>Constants</name>
              <emptyValue>&lt;empty&gt;</emptyValue>
              <singleFile>true</singleFile>
              <esModule>true</esModule>
              <typeScriptAsConst>true</typeScriptAsConst>
              <input>src/main/resources/com/github/xima_formcycle_entwicklerkreis/fc/plugin/codbi/constants.properties</input>
              <inputEncoding>UTF-8</inputEncoding>
              <output>${web.directory}/packages/common/src/js/constants.ts</output>
            </configuration>
          </execution>
          <execution>
            <id>generate-codbi-config-template-typescript</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>create-i18n-entries</goal>
            </goals>
            <configuration>
              <autoGeneratedComment>default</autoGeneratedComment>
              <kind>TYPESCRIPT_CONST</kind>
              <name>CodbiConfigTemplate</name>
              <emptyValue>&lt;empty&gt;</emptyValue>
              <singleFile>true</singleFile>
              <esModule>true</esModule>
              <typeScriptAsConst>true</typeScriptAsConst>
              <input>src/main/resources/com/github/xima_formcycle_entwicklerkreis/fc/plugin/codbi/codbi-config-template.properties</input>
              <inputEncoding>UTF-8</inputEncoding>
              <output>${web.directory}/packages/common/src/js/codbi-config-template.ts</output>
            </configuration>
          </execution>
          <execution>
            <id>generate-i18n-typescript</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>create-i18n-entries</goal>
            </goals>
            <configuration>
              <autoGeneratedComment>default</autoGeneratedComment>
              <kind>TYPESCRIPT_CONST</kind>
              <name>Messages</name>
              <singleFile>true</singleFile>
              <esModule>true</esModule>
              <typeScriptAsConst>true</typeScriptAsConst>
              <input>src/main/resources/com/github/xima_formcycle_entwicklerkreis/fc/plugin/codbi/i18n*.properties</input>
              <inputEncoding>UTF-8</inputEncoding>
              <output>${web.directory}/packages/common/src/js/localization.ts</output>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <autoGeneratedComment>default</autoGeneratedComment>
          <kind>JAVA_ENUM</kind>
          <name>EMessageKey</name>
          <javaPackage>com.github.xima_formcycle_entwicklerkreis.fc.plugin.codbi</javaPackage>
          <input>src/main/resources/com/github/xima_formcycle_entwicklerkreis/fc/plugin/codbi/i18n*.properties</input>
          <output>${project.build.directory}/generated-sources/com/github/xima_formcycle_entwicklerkreis/fc/plugin/codbi/EMessageKey.java</output>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>install node and yarn</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>install-node-and-yarn</goal>
            </goals>
          </execution>
          <execution>
            <id>yarn install</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>yarn</goal>
            </goals>
            <configuration>
              <arguments>install</arguments>
            </configuration>
          </execution>
          <execution>
            <id>build</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>yarn</goal>
            </goals>
            <configuration>
              <environmentVariables>
                <web_output_dir>${web.output.directory}</web_output_dir>
              </environmentVariables>
              <arguments>run build</arguments>
            </configuration>
          </execution>
          <execution>
            <id>test</id>
            <phase>test</phase>
            <goals>
              <goal>yarn</goal>
            </goals>
            <configuration>
              <arguments>test</arguments>
            </configuration>
          </execution>
          <execution>
            <id>lint</id>
            <phase>verify</phase>
            <goals>
              <goal>yarn</goal>
            </goals>
            <configuration>
              <arguments>run lint</arguments>
            </configuration>
          </execution>
          <execution>
            <id>docs</id>
            <phase>package</phase>
            <goals>
              <goal>yarn</goal>
            </goals>
            <configuration>
              <arguments>run docs</arguments>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <installDirectory>${project.build.directory}</installDirectory>
          <nodeVersion>${node.version}</nodeVersion>
          <yarnVersion>${yarn.version}</yarnVersion>
          <workingDirectory>${web.directory}</workingDirectory>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jetbrains.kotlin</groupId>
        <artifactId>kotlin-maven-plugin</artifactId>
        <extensions>true</extensions>
      </plugin>
      <plugin>
        <groupId>org.jetbrains.dokka</groupId>
        <artifactId>dokka-maven-plugin</artifactId>
        <version>${dokka-maven-plugin.version}</version>
        <configuration>
          <sourceDirectories>
            <dir>${dokka.sourceDir}</dir>
          </sourceDirectories>
          <outputDir>${dokka.outputDir}</outputDir>
          <jdkVersion>11</jdkVersion>
          <skipEmptyPackages>true</skipEmptyPackages>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <dependencies>
          <dependency>
            <groupId>me.fabriciorby</groupId>
            <artifactId>maven-surefire-junit5-tree-reporter</artifactId>
            <version>${maven-surefire-junit5-tree-reporter.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <useModulePath>false</useModulePath>
          <reportsDirectory>${project.build.directory}/${surefire.report.dirname}</reportsDirectory>
          <reportFormat>plain</reportFormat>
          <consoleOutputReporter>
            <disable>${quietTests}</disable>
          </consoleOutputReporter>
