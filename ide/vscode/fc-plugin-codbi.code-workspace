{
  "folders": [
    {
      "name": "ROOT",
      "path": "../../src/main/web"
    },
    {
      "name": "common",
      "path": "../../src/main/web/packages/common"
    },
    {
      "name": "designer",
      "path": "../../src/main/web/packages/designer"
    },
    {
      "name": "form",
      "path": "../../src/main/web/packages/form"
    }
  ],
  "extensions": {
    "recommendations": [
      "arcanis.vscode-zipfs",
      "streetsidesoftware.code-spell-checker",
      "firsttris.vscode-jest-runner",
      "biomejs.biome",
      "esbenp.prettier-vscode"
    ]
  },
  "settings": {
    "[css]": {
      "editor.defaultFormatter": "biomejs.biome"
    },
    "[javascript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true
    },
    "[typescript]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.formatOnSave": true
    },
    "[json]": {
      "editor.defaultFormatter": "vscode.json-language-features"
    },
    "editor.formatOnSave": true,
    "prettier.requireConfig": false,
    "prettier.enable": true,
    "prettier.configPath": "${workspaceFolder:ROOT}/.prettierrc.json",
    "typescript.tsdk": ".yarn/sdks/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "javascript.preferences.importModuleSpecifierEnding": "js",
    "typescript.preferences.importModuleSpecifierEnding": "js",
    "jestrunner.enableYarnPnpSupport": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.rulers": [
      {
        "color": "#cccccc",
        "column": 80
      },
      {
        "color": "#aa0000",
        "column": 120
      }
    ],
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never",
      "source.fixAll": "never"
    },
    "files.exclude": {
      "**/.git": true,
      "**/.svn": true,
      "**/.hg": true,
      "**/CVS": true,
      "**/.DS_Store": true,
      "**/.pnp.*": true,
      ".vim": true,
      ".vscode": true,
      "esbuild.js": true,
      "jest.config.js": true,
      "postcss.config.js": true,
      ".browserslistrc": true,
      "tsconfig.json": true,
      "biome.json": true,
      ".yarnrc.yml": true,
      "yarn.lock": true,
      ".yarn": true,
      "dist": true,
      "packages": true
    },
    "search.exclude": {
      "**/.yarn": true,
      "**/.pnp.*": true
    },
    "cSpell.customDictionaries": {
      "main": {
        "name": "workspace",
        "path": "${workspaceFolder:ROOT}/../../../ide/vscode/dictionary.txt",
        "addWords": true
      }
    }
  }
}
