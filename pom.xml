<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>
	<groupId>com.github.xima_formcycle_entwicklerkreis.fc.plugin</groupId>
	<artifactId>fc-plugin-codbi</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>jar</packaging>

	<name>fc-plugin-codbi</name>
	<description>formcycle plugin developed as a joint cooperation of the Bavarian formcycle developer community. Adds
        additional features to forms and the form designer.</description>
	<url>https://github.com/XIMA-formcycle-Entwicklerkreis/CodBi-Dev</url>

	<licenses>
		<license>
			<name>MIT</name>
			<url>https://opensource.org/license/mit</url>
		</license>
	</licenses>

	<contributors>
		<contributor>
			<name>Andre Wachsmuth</name>
			<email>awa@xima.de</email>
			<url>https://github.com/blutorange</url>
			<organization>xima media GmbH</organization>
			<organizationUrl>https://www.xima.de/</organizationUrl>
		</contributor>
	</contributors>

	<scm>
		<connection>scm:git:https://github.com/XIMA-formcycle-Entwicklerkreis/CodBi-Dev.git</connection>
		<developerConnection>scm:git:https://github.com/XIMA-formcycle-Entwicklerkreis/CodBi-Dev.git</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/XIMA-formcycle-Entwicklerkreis/CodBi-Dev</url>
	</scm>

	<issueManagement>
		<system>github</system>
		<url>https://github.com/XIMA-formcycle-Entwicklerkreis/CodBi-Dev/issues</url>
	</issueManagement>

	<properties>
		<!-- General settings -->
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.build.timestamp.format>yyyyMMddHHmm</maven.build.timestamp.format>
		<kotlin.compiler.incremental>false</kotlin.compiler.incremental>
		<quietTests>true</quietTests>

		<!-- Paths -->
		<failsafe.report.dirname>failsafe-reports</failsafe.report.dirname>
		<surefire.report.dirname>surefire-reports</surefire.report.dirname>
		<web.directory>${project.basedir}/src/main/web</web.directory>
		<web.output.directory>${project.build.directory}/generated-resources/com/github/xima_formcycle_entwicklerkreis/fc/plugin/codbi</web.output.directory>
		<web.yarn.directory>${web.directory}/.yarn</web.yarn.directory>

		<!-- Tools -->
		<biome.version>1.9.4</biome.version>
		<junit-jupiter.version>5.11.4</junit-jupiter.version>
		<kotlin.version>1.9.22</kotlin.version>
		<ktfmt.version>0.54</ktfmt.version>
		<maven.version>3.9.9</maven.version>
		<node.version>v22.14.0</node.version>
		<xfc.version>8.3.3</xfc.version>
		<yarn.version>v1.22.22</yarn.version>

		<!-- Dependency versions -->
		<jakarta-servlet-api.version>4.0.4</jakarta-servlet-api.version>
		<jackson.version>2.15.2</jackson.version>

		<!-- Plugins -->
		<build-helper-maven-plugin.version>3.6.0</build-helper-maven-plugin.version>
		<fc-build-helper-maven-plugin.version>2.9.0</fc-build-helper-maven-plugin.version>
		<fc-deploy-plugin-maven-plugin.version>8.0.2</fc-deploy-plugin-maven-plugin.version>
		<fc-server-maven-plugin.version>8.3.0</fc-server-maven-plugin.version>
		<git-build-hook-maven-plugin.version>3.5.0</git-build-hook-maven-plugin.version>
		<frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
		<maven-assembly-plugin.version>3.7.1</maven-assembly-plugin.version>
		<maven-clean-plugin.version>3.4.0</maven-clean-plugin.version>
		<maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
		<maven-deploy-plugin.version>3.1.3</maven-deploy-plugin.version>
		<maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
		<maven-enforcer-rule-ban-provided-dependencies.version>1.0.3</maven-enforcer-rule-ban-provided-dependencies.version>
		<maven-install-plugin.version>3.1.3</maven-install-plugin.version>
		<maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
		<maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
		<maven-site-plugin.version>3.21.0</maven-site-plugin.version>
		<maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
		<maven-surefire-junit5-tree-reporter.version>1.4.0</maven-surefire-junit5-tree-reporter.version>
		<properties-maven-plugin.version>1.2.1</properties-maven-plugin.version>
		<spotless-maven-plugin.version>2.44.2</spotless-maven-plugin.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<!-- Import third party libraries already provided by formcycle that we can make use of. -->
			<dependency>
				<groupId>de.xima.fc</groupId>
				<artifactId>fc</artifactId>
				<version>${xfc.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>

			<!-- Manage versions -->
			<dependency>
				<groupId>de.xima.fc</groupId>
				<artifactId>fc-ms-metro-gui</artifactId>
				<version>${xfc.version}</version>
				<classifier>classes</classifier>
			</dependency>

			<dependency>
				<groupId>jakarta.servlet</groupId>
				<artifactId>jakarta.servlet-api</artifactId>
				<version>${jakarta-servlet-api.version}</version>
			</dependency>

			<dependency>
				<groupId>org.junit.jupiter</groupId>
				<artifactId>junit-jupiter-engine</artifactId>
				<version>${junit-jupiter.version}</version>
			</dependency>

			<dependency>
				<groupId>com.fasterxml.jackson.module</groupId>
				<artifactId>jackson-module-kotlin</artifactId>
				<version>${jackson.version}</version>
			</dependency>

			<dependency>
				<groupId>com.fasterxml.jackson.core</groupId>
				<artifactId>jackson-annotations</artifactId>
				<version>${jackson.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<!-- formcycle plugin API -->
		<dependency>
			<groupId>de.xima.fc</groupId>
			<artifactId>fc-plugin-common</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- Kotlin standard library -->
		<dependency>
			<groupId>org.jetbrains.kotlin</groupId>
			<artifactId>kotlin-stdlib</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- Servlet API for tests -->
		<dependency>
			<groupId>jakarta.servlet</groupId>
			<artifactId>jakarta.servlet-api</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- JUnit for unit tests -->
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Additional formcycle classes for tests -->
		<dependency>
			<groupId>de.xima.fc</groupId>
			<artifactId>fc-logic</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>com.fasterxml.jackson.module</groupId>
			<artifactId>jackson-module-kotlin</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-core</artifactId>
		</dependency>
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-annotations</artifactId>
		</dependency>
	</dependencies>

	<!-- Maven repository provided by xima -->
	<repositories>
		<repository>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
			<id>xima</id>
			<name>fc-plugin-dev</name>
			<url>https://artifactory.xima-services.de/artifactory/fc-plugin-dev</url>
		</repository>
	</repositories>

	<!-- Maven plugin repository provided by xima -->
	<pluginRepositories>
		<pluginRepository>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
			<id>xima</id>
			<name>fc-plugin-dev</name>
			<url>https://artifactory.xima-services.de/artifactory/fc-plugin-dev</url>
		</pluginRepository>
	</pluginRepositories>

	<build>
		<finalName>${project.artifactId}</finalName>

		<!-- Include generated (bundled, minified) JavaScript and CSS resources -->
		<resources>
			<resource>
				<directory>${project.basedir}/src/main/resources</directory>
			</resource>
			<resource>
				<directory>${project.build.directory}/generated-resources</directory>
			</resource>
		</resources>

		<!-- Define versions for Maven plugins -->
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>build-helper-maven-plugin</artifactId>
					<version>${build-helper-maven-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>de.xima.fc.maven.plugin</groupId>
					<artifactId>fc-build-helper-maven-plugin</artifactId>
					<version>${fc-build-helper-maven-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>de.xima.fc.maven.plugin</groupId>
					<artifactId>fc-deploy-plugin-maven-plugin</artifactId>
					<version>${fc-deploy-plugin-maven-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>de.xima.fc.maven.plugin</groupId>
					<artifactId>fc-server-maven-plugin</artifactId>
					<version>${fc-server-maven-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>com.github.eirslett</groupId>
					<artifactId>frontend-maven-plugin</artifactId>
					<version>${frontend-maven-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>com.rudikershaw.gitbuildhook</groupId>
					<artifactId>git-build-hook-maven-plugin</artifactId>
					<version>${git-build-hook-maven-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.jetbrains.kotlin</groupId>
					<artifactId>kotlin-maven-plugin</artifactId>
					<version>${kotlin.version}</version>
					<configuration>
						<apiVersion>1.9</apiVersion>
						<languageVersion>1.9</languageVersion>
						<jvmTarget>11</jvmTarget>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-assembly-plugin</artifactId>
					<version>${maven-assembly-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-clean-plugin</artifactId>
					<version>${maven-clean-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>${maven-compiler-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-deploy-plugin</artifactId>
					<version>${maven-deploy-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-enforcer-plugin</artifactId>
					<version>${maven-enforcer-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-install-plugin</artifactId>
					<version>${maven-install-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-jar-plugin</artifactId>
					<version>${maven-jar-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-resources-plugin</artifactId>
					<version>${maven-resources-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-site-plugin</artifactId>
					<version>${maven-site-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>${maven-surefire-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>properties-maven-plugin</artifactId>
					<version>${properties-maven-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>com.diffplug.spotless</groupId>
					<artifactId>spotless-maven-plugin</artifactId>
					<version>${spotless-maven-plugin.version}</version>
				</plugin>
			</plugins>
		</pluginManagement>

		<plugins>
			<!-- Cleaning -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<configuration>
					<excludeDefaultDirectories>false</excludeDefaultDirectories>
					<filesets>
						<fileset>
							<directory>${web.directory}/dist</directory>
						</fileset>
						<fileset>
							<directory>${web.directory}/packages/common/dist</directory>
						</fileset>
						<fileset>
							<directory>${web.directory}/packages/form/dist</directory>
						</fileset>
						<fileset>
							<directory>${web.directory}/packages/designer/dist</directory>
						</fileset>
						<fileset>
							<directory>${web.yarn.directory}/unplugged</directory>
							<followSymlinks>false</followSymlinks>
						</fileset>
						<fileset>
							<directory>${web.yarn.directory}</directory>
							<includes>
								<include>build-state.yml</include>
								<include>install-state.gz</include>
							</includes>
						</fileset>
						<fileset>
							<directory>${web.directory}</directory>
							<includes>
								<include>**.tgz</include>
								<include>.pnp.*</include>
								<include>**/localization.ts</include>
								<include>**/constants.ts</include>
							</includes>
						</fileset>
					</filesets>
				</configuration>
			</plugin>

			<!-- Load values from constants.properties and make them available to the Maven build process -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>properties-maven-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>read-project-properties</goal>
						</goals>
						<phase>initialize</phase>
						<configuration>
							<files>
								<file>src/main/resources/com/github/xima_formcycle_entwicklerkreis/fc/plugin/codbi/constants.properties</file>
							</files>
							<keyPrefix>constants.</keyPrefix>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Install git hook that applies the spotless formatter. -->
			<plugin>
				<groupId>com.rudikershaw.gitbuildhook</groupId>
				<artifactId>git-build-hook-maven-plugin</artifactId>
				<configuration>
					<installHooks>
						<pre-commit>hooks/pre-commit</pre-commit>
					</installHooks>
				</configuration>
				<executions>
					<execution>
						<?m2e ignore?>
						<goals>
							<goal>install</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Include generated-sources as Java source -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>add-source</id>
						<goals>
							<goal>add-source</goal>
						</goals>
						<phase>generate-sources</phase>
						<configuration>
							<sources>
								<source>${project.build.directory}/generated-sources</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Format code via spotless -->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<configuration>
					<kotlin>
						<ktfmt>
							<version>${ktfmt.version}</version>
							<style>META</style>
							<maxWidth>100</maxWidth>
							<blockIndent>2</blockIndent>
							<continuationIndent>4</continuationIndent>
							<removeUnusedImports>true</removeUnusedImports>
							<manageTrailingCommas>false</manageTrailingCommas>
						</ktfmt>
					</kotlin>

					<pom>
						<includes>
							<include>pom.xml</include>
						</includes>
						<sortPom>
							<lineSeparator>\n</lineSeparator>
							<nrOfIndentSpace>-1</nrOfIndentSpace>
							<keepBlankLines>true</keepBlankLines>
							<expandEmptyElements>false</expandEmptyElements>
						</sortPom>
					</pom>

					<formats>
						<format>
							<includes>
								<include>src/**/*.ts</include>
								<include>src/**/*.js</include>
								<include>src/**/*.json</include>
							</includes>
							<excludes>
								<exclude>**/package.json</exclude>
								<exclude>**/.yarn/**</exclude>
								<exclude>**/node_modules/**</exclude>
								<exclude>**/.pnp*</exclude>
								<exclude>**/target/**</exclude>
								<exclude>**/dist/**</exclude>
								<exclude>**/localization.ts</exclude>
							</excludes>
							<biome>
								<version>${biome.version}</version>
								<configPath>${web.directory}</configPath>
							</biome>
						</format>
					</formats>
				</configuration>
			</plugin>

			<!-- Enforce build-related rules -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
				<dependencies>
					<dependency>
						<groupId>de.xima.fc.maven.enforcer</groupId>
						<artifactId>maven-enforcer-rule-ban-provided-dependencies</artifactId>
						<version>${maven-enforcer-rule-ban-provided-dependencies.version}</version>
					</dependency>
				</dependencies>
				<executions>
					<execution>
						<id>default-cli</id>
						<goals>
							<goal>enforce</goal>
						</goals>
						<configuration>
							<rules>
								<requireJavaVersion>
									<version>[11,]</version>
								</requireJavaVersion>
								<requireMavenVersion>
									<version>${maven.version}</version>
								</requireMavenVersion>
								<dependencyConvergence/>
								<reactorModuleConvergence/>
								<banDuplicatePomDependencyVersions/>
								<requirePluginVersions/>
								<requireUpperBoundDeps/>
								<banProvidedDependencies>
									<provisions>
										<provision>
											<groupId>de.xima.fc</groupId>
											<artifactId>fc-plugin-common</artifactId>
										</provision>
									</provisions>
								</banProvidedDependencies>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Various tools, see individual executions for details -->
			<plugin>
				<groupId>de.xima.fc.maven.plugin</groupId>
				<artifactId>fc-build-helper-maven-plugin</artifactId>
				<configuration>
					<autoGeneratedComment>default</autoGeneratedComment>
					<kind>JAVA_ENUM</kind>
					<name>EMessageKey</name>
					<javaPackage>com.github.xima_formcycle_entwicklerkreis.fc.plugin.codbi</javaPackage>
					<input>src/main/resources/com/github/xima_formcycle_entwicklerkreis/fc/plugin/codbi/i18n*.properties</input>
					<output>${project.build.directory}/generated-sources/com/github/xima_formcycle_entwicklerkreis/fc/plugin/codbi/EMessageKey.java</output>
				</configuration>
				<executions>
					<!-- Removed outdated snapshots from yarn's cache -->
					<execution>
						<?m2e ignore?>
						<id>clean-yarn-snapshots</id>
						<goals>
							<goal>delete-outdated-snapshots-from-yarn-cache</goal>
						</goals>
						<phase>initialize</phase>
						<configuration>
							<yarnProjectRoot>${web.directory}</yarnProjectRoot>
						</configuration>
					</execution>

					<!-- Sync versions in package.json with the Maven project -->
					<execution>
						<?m2e execute onConfiguration,onIncremental?>
						<id>set-package-json-versions</id>
						<goals>
							<goal>update-package-json-versions</goal>
						</goals>
						<phase>initialize</phase>
						<configuration>
							<inputs>
								<input>${web.directory}/package.json</input>
							</inputs>
							<recurse>true</recurse>
							<updates>
								<update>
									<packageName>codbi</packageName>
									<version>${project.version}</version>
									<updateInPackage>true</updateInPackage>
									<updateInDependency>false</updateInDependency>
								</update>
								<update>
									<packageName>codbi-common</packageName>
									<version>${project.version}</version>
									<updateInPackage>true</updateInPackage>
									<updateInDependency>false</updateInDependency>
								</update>
								<update>
									<packageName>codbi-designer</packageName>
									<version>${project.version}</version>
									<updateInPackage>true</updateInPackage>
									<updateInDependency>false</updateInDependency>
								</update>
								<update>
									<packageName>codbi-form</packageName>
									<version>${project.version}</version>
									<updateInPackage>true</updateInPackage>
									<updateInDependency>false</updateInDependency>
								</update>
								<update>
									<packageName>@de-xima/fc-backend-common</packageName>
									<version>${xfc.version}</version>
								</update>
								<update>
									<packageName>@de-xima/fc-form-renderer</packageName>
									<version>${xfc.version}</version>
								</update>
								<update>
									<packageName>@de-xima/fc-form-designer</packageName>
									<version>${xfc.version}</version>
								</update>
							</updates>
						</configuration>
					</execution>

					<!-- Create Kotlin class with constants -->
					<execution>
						<?m2e execute onConfiguration,onIncremental?>
						<id>generate-constants-kotlin</id>
						<goals>
							<goal>create-i18n-entries</goal>
						</goals>
						<phase>generate-sources</phase>
						<configuration>
							<autoGeneratedComment>default</autoGeneratedComment>
							<emptyValue>&lt;empty&gt;</emptyValue>
							<kind>KOTLIN_CONST</kind>
							<name>Constants</name>
							<javaPackage>com.github.xima_formcycle_entwicklerkreis.fc.plugin.codbi.model</javaPackage>
							<input>src/main/resources/com/github/xima_formcycle_entwicklerkreis/fc/plugin/codbi/constants.properties</input>
							<inputEncoding>UTF-8</inputEncoding>
							<output>${project.build.directory}/generated-sources/com/github/xima_formcycle_entwicklerkreis/fc/plugin/codbi/model/Constants.kt</output>
						</configuration>
					</execution>

					<!-- Create Kotlin enum with codbi config template options -->
					<execution>
						<?m2e execute onConfiguration,onIncremental?>
						<id>generate-codbi-config-template-kotlin</id>
						<goals>
							<goal>create-i18n-key-declarations</goal>
						</goals>
						<phase>generate-sources</phase>
						<configuration>
							<autoGeneratedComment>default</autoGeneratedComment>
							<kind>KOTLIN_ENUM</kind>
							<name>CodbiConfigTemplate</name>
							<javaPackage>com.github.xima_formcycle_entwicklerkreis.fc.plugin.codbi.model</javaPackage>
							<input>src/main/resources/com/github/xima_formcycle_entwicklerkreis/fc/plugin/codbi/codbi-config-template.properties</input>
							<inputEncoding>UTF-8</inputEncoding>
							<output>${project.build.directory}/generated-sources/com/github/xima_formcycle_entwicklerkreis/fc/plugin/codbi/model/CodbiConfigTemplate.kt</output>
						</configuration>
					</execution>

					<!-- Create Kotlin enum with I18N key names -->
					<execution>
						<?m2e execute onConfiguration,onIncremental?>
						<id>generate-i18n-keys-kotlin</id>
						<goals>
							<goal>create-i18n-key-declarations</goal>
						</goals>
						<phase>generate-sources</phase>
						<configuration>
							<autoGeneratedComment>default</autoGeneratedComment>
							<kind>KOTLIN_ENUM</kind>
							<name>EMessageKey</name>
							<javaPackage>com.github.xima_formcycle_entwicklerkreis.fc.plugin.codbi.model</javaPackage>
							<input>src/main/resources/com/github/xima_formcycle_entwicklerkreis/fc/plugin/codbi/i18n*.properties</input>
							<inputEncoding>UTF-8</inputEncoding>
							<output>${project.build.directory}/generated-sources/com/github/xima_formcycle_entwicklerkreis/fc/plugin/codbi/model/EMessageKey.kt</output>
						</configuration>
					</execution>

					<!-- Create TypeScript file with constants -->
					<execution>
						<?m2e execute onConfiguration,onIncremental?>
						<id>generate-constants-typescript</id>
						<goals>
							<goal>create-i18n-entries</goal>
						</goals>
						<phase>generate-resources</phase>
						<configuration>
							<autoGeneratedComment>default</autoGeneratedComment>
							<kind>TYPESCRIPT_CONST</kind>
							<name>Constants</name>
							<emptyValue>&lt;empty&gt;</emptyValue>
							<singleFile>true</singleFile>
							<esModule>true</esModule>
							<typeScriptAsConst>true</typeScriptAsConst>
							<input>src/main/resources/com/github/xima_formcycle_entwicklerkreis/fc/plugin/codbi/constants.properties</input>
							<inputEncoding>UTF-8</inputEncoding>
							<output>${web.directory}/packages/common/src/js/constants.ts</output>
						</configuration>
					</execution>

					<!-- Create TypeScript file with codbi config template options -->
					<execution>
						<?m2e execute onConfiguration,onIncremental?>
						<id>generate-codbi-config-template-typescript</id>
						<goals>
							<goal>create-i18n-entries</goal>
						</goals>
						<phase>generate-resources</phase>
						<configuration>
							<autoGeneratedComment>default</autoGeneratedComment>
							<kind>TYPESCRIPT_CONST</kind>
							<name>CodbiConfigTemplate</name>
							<emptyValue>&lt;empty&gt;</emptyValue>
							<singleFile>true</singleFile>
							<esModule>true</esModule>
							<typeScriptAsConst>true</typeScriptAsConst>
							<input>src/main/resources/com/github/xima_formcycle_entwicklerkreis/fc/plugin/codbi/codbi-config-template.properties</input>
							<inputEncoding>UTF-8</inputEncoding>
							<output>${web.directory}/packages/common/src/js/codbi-config-template.ts</output>
						</configuration>
					</execution>

					<!-- Create TypeScript file with localized messages -->
					<execution>
						<?m2e execute onConfiguration,onIncremental?>
						<id>generate-i18n-typescript</id>
						<goals>
							<goal>create-i18n-entries</goal>
						</goals>
						<phase>generate-resources</phase>
						<configuration>
							<autoGeneratedComment>default</autoGeneratedComment>
							<kind>TYPESCRIPT_CONST</kind>
							<name>Messages</name>
							<singleFile>true</singleFile>
							<esModule>true</esModule>
							<typeScriptAsConst>true</typeScriptAsConst>
							<input>src/main/resources/com/github/xima_formcycle_entwicklerkreis/fc/plugin/codbi/i18n*.properties</input>
							<inputEncoding>UTF-8</inputEncoding>
							<output>${web.directory}/packages/common/src/js/localization.ts</output>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Transpile and minify CSS + TypeScript via esbuild -->
			<plugin>
				<groupId>com.github.eirslett</groupId>
				<artifactId>frontend-maven-plugin</artifactId>
				<configuration>
					<installDirectory>${project.build.directory}</installDirectory>
					<nodeVersion>${node.version}</nodeVersion>
					<yarnVersion>${yarn.version}</yarnVersion>
					<workingDirectory>${web.directory}</workingDirectory>
				</configuration>
				<executions>
					<!-- Install node / yarn -->
					<execution>
						<?m2e ignore?>
						<id>install node and yarn</id>
						<goals>
							<goal>install-node-and-yarn</goal>
						</goals>
						<phase>generate-resources</phase>
					</execution>

					<!-- Resolve and install package dependencies -->
					<execution>
						<?m2e ignore?>
						<id>yarn install</id>
						<goals>
							<goal>yarn</goal>
						</goals>
						<phase>generate-resources</phase>
						<configuration>
							<arguments>install</arguments>
						</configuration>
					</execution>

					<!-- Build package -->
					<execution>
						<?m2e ignore?>
						<id>build</id>
						<goals>
							<goal>yarn</goal>
						</goals>
						<phase>generate-resources</phase>
						<configuration>
							<environmentVariables>
								<web_output_dir>${web.output.directory}</web_output_dir>
							</environmentVariables>
							<arguments>run build</arguments>
						</configuration>
					</execution>

					<!-- Test package -->
					<execution>
						<?m2e ignore?>
						<id>test</id>
						<goals>
							<goal>yarn</goal>
						</goals>
						<phase>test</phase>
						<configuration>
							<arguments>test</arguments>
						</configuration>
					</execution>

					<!-- Lint code -->
					<execution>
						<?m2e ignore?>
						<id>lint</id>
						<goals>
							<goal>yarn</goal>
						</goals>
						<phase>verify</phase>
						<configuration>
							<arguments>run lint</arguments>
						</configuration>
					</execution>
					<!-- Generate TypeDoc -->
					<execution>
						<?m2e ignore?>
						<id>docs</id>
						<goals>
							<goal>yarn</goal>
						</goals>
						<phase>package</phase>
						<configuration>
							<arguments>run docs</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Compile Kotlin source code -->
			<plugin>
				<groupId>org.jetbrains.kotlin</groupId>
				<artifactId>kotlin-maven-plugin</artifactId>
				<extensions>true</extensions>
			</plugin>

			<!-- Run unit tests via surefire -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>${maven-surefire-plugin.version}</version>
				<configuration>
					<useModulePath>false</useModulePath>
					<reportsDirectory>${project.build.directory}/${surefire.report.dirname}</reportsDirectory>
					<reportFormat>plain</reportFormat>
					<consoleOutputReporter>
						<disable>${quietTests}</disable>
					</consoleOutputReporter>
					<statelessTestsetInfoReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5StatelessTestsetInfoTreeReporter">
						<usePhrasedFileName>true</usePhrasedFileName>
						<usePhrasedClassNameInRunning>true</usePhrasedClassNameInRunning>
						<usePhrasedClassNameInTestCaseSummary>true</usePhrasedClassNameInTestCaseSummary>
						<printStacktraceOnError>true</printStacktraceOnError>
						<printStacktraceOnFailure>true</printStacktraceOnFailure>
						<printStdoutOnError>${quietTests}</printStdoutOnError>
						<printStdoutOnFailure>${quietTests}</printStdoutOnFailure>
						<printStderrOnError>${quietTests}</printStderrOnError>
						<printStderrOnFailure>${quietTests}</printStderrOnFailure>
						<theme>UNICODE</theme>
					</statelessTestsetInfoReporter>
				</configuration>
				<dependencies>
					<dependency>
						<groupId>me.fabriciorby</groupId>
						<artifactId>maven-surefire-junit5-tree-reporter</artifactId>
						<version>${maven-surefire-junit5-tree-reporter.version}</version>
					</dependency>
				</dependencies>
			</plugin>

			<!-- Create a fat JAR with all dependencies -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<configuration>
					<descriptorRefs>
						<descriptorRef>jar-with-dependencies</descriptorRef>
					</descriptorRefs>
					<appendAssemblyId>false</appendAssemblyId>
					<archive>
						<manifest>
							<addDefaultImplementationEntries>true</addDefaultImplementationEntries>
						</manifest>
						<manifestEntries>
							<!-- This plugin is available in the official formcycle store. -->
							<Plugin-Repository>xfc-proma</Plugin-Repository>
							<!-- Globally unique ID of this plugin -->
							<!-- Loaded dynamically from constant.properties -->
							<!--suppress MavenModelInspection -->
							<Plugin-Key>${constants.plugin.key}</Plugin-Key>
							<Build-Timestamp>${maven.build.timestamp}</Build-Timestamp>
							<Implementation-Title>${project.groupId}:${project.artifactId}</Implementation-Title>
							<Implementation-Vendor-Id>${project.groupId}</Implementation-Vendor-Id>
							<Implementation-Version>${project.version}</Implementation-Version>
							<formcycle-version-requirement>${xfc.version}</formcycle-version-requirement>
						</manifestEntries>
					</archive>
				</configuration>
				<executions>
					<execution>
						<id>make-assembly</id>
						<goals>
							<goal>single</goal>
						</goals>
						<!-- bind to the packaging phase -->
						<phase>package</phase>
					</execution>
				</executions>
			</plugin>

			<!-- For deploying the JAR file to a formcycle server via HTTP. Just run: -->
			<!-- mvn fc-deploy:deploy -->
			<!-- To change the FORMCYCLE URL and the deployment token/password, add these parameters -->
			<!-- -DfcDeployUrl=http://localhost:8080/xima-formcycle -DfcDeployToken=admin -->
			<plugin>
				<groupId>de.xima.fc.maven.plugin</groupId>
				<artifactId>fc-deploy-plugin-maven-plugin</artifactId>
			</plugin>

			<!-- Start a preconfigured formcycle server with this plugin -->
			<!-- mvn fc-server:run-ms-war -->
			<plugin>
				<groupId>de.xima.fc.maven.plugin</groupId>
				<artifactId>fc-server-maven-plugin</artifactId>
				<configuration>
					<appDir>xfc-server</appDir>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<source>9</source>
					<target>9</target>
				</configuration>
			</plugin>
		</plugins>

		<sourceDirectory>${project.basedir}/src/main/kotlin</sourceDirectory>
		<testSourceDirectory>${project.basedir}/src/test/kotlin</testSourceDirectory>
	</build>

	<profiles>
		<!-- For development: creates non-minimized resources for better debugging -->
		<profile>
			<id>dev</id>
			<properties>
				<skipTests>true</skipTests>
			</properties>
			<build>
				<plugins>
					<!-- Skip enforcer for dev build -->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-enforcer-plugin</artifactId>
						<configuration>
							<skip>true</skip>
						</configuration>
					</plugin>
					<plugin>
						<groupId>com.github.eirslett</groupId>
						<artifactId>frontend-maven-plugin</artifactId>
						<executions>
							<!-- Create non-minimized resources with source maps instead -->
							<execution>
								<?m2e ignore?>
								<id>build</id>
								<goals>
									<goal>yarn</goal>
								</goals>
								<phase>generate-resources</phase>
								<configuration>
									<arguments>run build-dev</arguments>
									<environmentVariables>
										<web_output_dir>${web.output.directory}</web_output_dir>
									</environmentVariables>
								</configuration>
							</execution>
							<!-- Skip lint for dev build -->
							<execution>
								<?m2e ignore?>
								<id>lint</id>
								<goals>
									<goal>yarn</goal>
								</goals>
								<configuration>
									<skip>true</skip>
								</configuration>
							</execution>
							<!-- Skip docs for dev build -->
							<execution>
								<?m2e ignore?>
								<id>docs</id>
								<goals>
									<goal>yarn</goal>
								</goals>
								<configuration>
									<skip>true</skip>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<!-- Enforce that no dependencies already provided by formcycle -->
		<!-- (=fc-ms-metro-gui) are included in the final plugin JAR file. -->
		<!-- Run with mvn enforcer:enforce -P enforce -->
		<profile>
			<id>enforce</id>
			<dependencies>
				<dependency>
					<groupId>de.xima.fc</groupId>
					<artifactId>fc-ms-metro-gui</artifactId>
					<classifier>classes</classifier>
					<scope>provided</scope>
				</dependency>
			</dependencies>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-enforcer-plugin</artifactId>
						<executions>
							<execution>
								<id>default-cli</id>
								<configuration>
									<rules>
										<banProvidedDependencies>
											<provisions>
												<provision>
													<groupId>de.xima.fc</groupId>
													<artifactId>fc-ms-metro-gui</artifactId>
													<classifier>classes</classifier>
												</provision>
											</provisions>
										</banProvidedDependencies>
									</rules>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
