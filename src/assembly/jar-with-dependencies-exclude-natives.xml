<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 http://maven.apache.org/xsd/assembly-2.1.0.xsd">
    <id>jar-with-dependencies</id>
    <formats>
        <format>jar</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <dependencySets>
        <dependencySet>
            <outputDirectory>/</outputDirectory>
            <useProjectArtifact>true</useProjectArtifact>
            <unpack>true</unpack>
            <scope>runtime</scope>
            <unpackOptions>
                <excludes>
                    <!-- Exclude the root "native/" payload from ALL dependencies (tokenizers, etc.). -->
                    <exclude>native/**</exclude>
                    <!-- Exclude Tesseract language/model data (downloaded at runtime by Tesseract.kt). -->
                    <exclude>tessdata/**</exclude>
                    <exclude>**/*.traineddata</exclude>
                    <!-- Exclude Tess4J native payload (downloaded/extracted at runtime by Tesseract.kt). -->
                    <exclude>win32-x86/**</exclude>
                    <exclude>win32-x86-64/**</exclude>
                    <!-- Exclude bundled Tesseract runtime libs from project resources (downloaded at runtime by Tesseract.kt). -->
                    <exclude>AI/Tesseract/Runtime/**</exclude>
                    <!-- Exclude ONNX Runtime native payload completely (ORT is downloaded/extracted at runtime). -->
                    <exclude>ai/onnxruntime/native/**</exclude>
                    <exclude>AI/onnxruntime/native/**</exclude>
                    <!-- Some builds include the native payload under an upper-case AI folder. Exclude it entirely. -->
                    <exclude>AI/onnxruntime/**</exclude>
                </excludes>
            </unpackOptions>
        </dependencySet>
    </dependencySets>
    <fileSets>
        <fileSet>
            <directory>${project.build.outputDirectory}</directory>
            <outputDirectory>/</outputDirectory>
            <excludes>
                <exclude>native/**</exclude>
                <exclude>tessdata/**</exclude>
                <exclude>**/*.traineddata</exclude>
                <exclude>win32-x86/**</exclude>
                <exclude>win32-x86-64/**</exclude>
                <exclude>AI/Tesseract/Runtime/**</exclude>
                <exclude>ai/onnxruntime/native/</exclude>
                <exclude>ai/onnxruntime/native/**</exclude>
                <exclude>AI/onnxruntime/native/</exclude>
                <exclude>AI/onnxruntime/native/**</exclude>
                <exclude>AI/onnxruntime/**</exclude>
            </excludes>
        </fileSet>
    </fileSets>
</assembly>
