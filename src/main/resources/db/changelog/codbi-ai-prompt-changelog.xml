<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="codbi-ai-prompt-1" author="codbi">
        <comment>Create table for AI system prompts used by CodBi AI assistants</comment>
        <createTable tableName="codbi_ai_prompt">
            <column name="prompt_key" type="VARCHAR(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="prompt_text" type="CLOB">
                <constraints nullable="false"/>
            </column>
            <column name="prompt_version" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="codbi_ai_prompt"/>
        </rollback>
    </changeSet>

    <changeSet id="codbi-ai-prompt-2" author="codbi">
        <comment>
          Extend codbi_ai_prompt with columns for the Prompt Manager UI:
          is_active (toggle to exclude from AI requests),
          pre_prompt/post_prompt (custom user text wrapped around the main prompt),
          original_text (snapshot of the seeded prompt for restore),
          display_name (human-readable label for the UI)
        </comment>
        <addColumn tableName="codbi_ai_prompt">
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="pre_prompt" type="CLOB"/>
            <column name="post_prompt" type="CLOB"/>
            <column name="original_text" type="CLOB"/>
            <column name="display_name" type="VARCHAR(200)"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="codbi_ai_prompt" columnName="is_active"/>
            <dropColumn tableName="codbi_ai_prompt" columnName="pre_prompt"/>
            <dropColumn tableName="codbi_ai_prompt" columnName="post_prompt"/>
            <dropColumn tableName="codbi_ai_prompt" columnName="original_text"/>
            <dropColumn tableName="codbi_ai_prompt" columnName="display_name"/>
        </rollback>
    </changeSet>

    <changeSet id="codbi-ai-prompt-3" author="codbi">
        <comment>
          Add pre_prompt_active and post_prompt_active columns to allow
          disabling pre/post prompts independently while keeping the
          main prompt active. When pre/post is deactivated, the tree
          shows a yellow indicator instead of red.
        </comment>
        <addColumn tableName="codbi_ai_prompt">
            <column name="pre_prompt_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="post_prompt_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="codbi_ai_prompt" columnName="pre_prompt_active"/>
            <dropColumn tableName="codbi_ai_prompt" columnName="post_prompt_active"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
