<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="codbi-compact-prompt-1" author="codbi">
        <comment>Create table for compact (codbi-core-elements-compact / codbi-core-api-compact) AI prompts</comment>
        <createTable tableName="codbi_compact_prompt">
            <column name="prompt_key" type="VARCHAR(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="prompt_text" type="CLOB">
                <constraints nullable="false"/>
            </column>
            <column name="prompt_version" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="pre_prompt" type="CLOB"/>
            <column name="post_prompt" type="CLOB"/>
            <column name="original_text" type="CLOB"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="display_name" type="VARCHAR(200)"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <dropTable tableName="codbi_compact_prompt"/>
        </rollback>
    </changeSet>

    <changeSet id="codbi-compact-prompt-2" author="codbi">
        <comment>
          Add pre_prompt_active and post_prompt_active columns to allow
          disabling pre/post prompts independently while keeping the
          main prompt active.
        </comment>
        <addColumn tableName="codbi_compact_prompt">
            <column name="pre_prompt_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="post_prompt_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="codbi_compact_prompt" columnName="pre_prompt_active"/>
            <dropColumn tableName="codbi_compact_prompt" columnName="post_prompt_active"/>
        </rollback>
    </changeSet>

    <changeSet id="codbi-compact-prompt-3" author="codbi">
        <comment>
          Add is_system flag to distinguish built-in system prompts from
          user-created prompts. Built-in prompts are seeded from classpath
          resources; user prompts are created via the Prompt Manager UI.
          Only user-created prompts can be renamed or deleted.
        </comment>
        <addColumn tableName="codbi_compact_prompt">
            <column name="is_system" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="codbi_compact_prompt" columnName="is_system"/>
        </rollback>
    </changeSet>

    <changeSet id="codbi-compact-prompt-4" author="codbi">
        <comment>Increase prompt_key column size from VARCHAR(100) to VARCHAR(200)</comment>
        <modifyDataType tableName="codbi_compact_prompt" columnName="prompt_key" newDataType="VARCHAR(200)"/>
        <rollback>
            <modifyDataType tableName="codbi_compact_prompt" columnName="prompt_key" newDataType="VARCHAR(100)"/>
        </rollback>
    </changeSet>

    <changeSet id="codbi-compact-prompt-5" author="codbi">
        <comment>
          Add update_available flag to indicate that a newer version of a system prompt
          exists in the bundled .md resources while the local copy was customized by the
          user. The Prompt Manager uses this to show a hint that offers to load the new
          version via "Restore Original".
        </comment>
        <addColumn tableName="codbi_compact_prompt">
            <column name="update_available" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="codbi_compact_prompt" columnName="update_available"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
