{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 120
  },
  "organizeImports": {
    "enabled": true
  },
  "files": {
    "ignore": ["package.json", "localization.ts"],
    "ignoreUnknown": true,
    "maxSize": 4194304
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": ["$"]
          }
        },
        "noInferrableTypes": "off",
        "noParameterProperties": "error",
        "useBlockStatements": "error",
        "useFragmentSyntax": "error",
        "noUselessElse": "off"
      }
    }
  }
}
