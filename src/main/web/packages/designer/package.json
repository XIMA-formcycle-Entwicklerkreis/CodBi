{
  "private": true,
  "type": "module",
  "name": "codbi-designer",
  "version": "1.0.1",
  "stableVersion": "1.0.1",
  "sideEffects": [
    "./src/index-designer.ts"
  ],
  "scripts": {
    "build": "node esbuild.js --mode=production",
    "build-dev": "node esbuild.js --mode=development",
    "docs": "typedoc",
    "lint": "biome lint --config-path ../.. src __tests__ __mocks__",
    "lint-apply": "biome lint --apply --config-path ../.. src __tests__ __mocks__",
    "lint-apply-unsafe": "biome lint --apply-unsafe --config-path ../.. src __tests__ __mocks__",
    "test": "jest"
  },
  "dependencies": {
    "@de-xima/fc-form-designer": "8.5.3",
    "@de-xima/xima-common-js-lang": "^7.1.0",
    "@ngneat/transloco": "^6.0.4",
    "@tinymce/tinymce-angular": "^9.1.1",
    "codbi-common": "workspace:*",
    "rxjs": "~7.8.0",
    "tinymce": "^7.9.1",
    "tslib": "~2.8.1",
    "xdbc": "^1.0.220",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@de-xima/esbuild-plugin-postcss": "~1.0.1",
    "@jest/globals": "~29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "~22.13.4",
    "@typescript/lib-dom": "npm:@types/web@0.0.202",
    "@typhonjs-typedoc/ts-lib-docs": "^2024.12.25",
    "@typhonjs-typedoc/typedoc-theme-dmt": "^0.4.0",
    "autoprefixer": "~10.5.0",
    "esbuild": "0.28.1",
    "jest": "~29.7.0",
    "jest-environment-jsdom": "~29.7.0",
    "postcss": "~8.5.15",
    "postcss-load-config": "~6.0.1",
    "ts-jest": "^29.4.11",
    "typedoc": "^0.28.19",
    "typescript": "~5.7.3"
  }
}
